generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SUPERVISEUR
  TECHNICIEN
  // Réceptionniste du support client (chat vitrine) — accès limité au
  // tableau de bord des conversations, jamais aux modules métier (factures,
  // clients, etc.). Voir lib/auth/rbac.ts.
  SUPPORT
}

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  INSTITUTION
  ONG
}

enum TypeContrat {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  PONCTUEL
}

enum StatutContrat {
  ACTIF
  EXPIRE
  SUSPENDU
  RESILIE
}

enum StatutIntervention {
  EN_ATTENTE
  PLANIFIE
  EN_COURS
  COMPLETE
  ANNULE
}

enum Priorite {
  NORMALE
  URGENTE
}

// Comment la demande est arrivée jusqu'à JEDCO. Une intervention n'est
// jamais créée automatiquement (voir CreerInterventionInput) — c'est
// toujours un membre du personnel qui la saisit, y compris quand la demande
// initiale vient du formulaire public (DemandeDevis/RendezVous). Sans ce
// champ, une intervention issue du site web et une intervention née d'un
// appel téléphonique étaient indiscernables une fois dans le système.
enum CanalDemande {
  WEB
  TELEPHONE
  TERRAIN
}

enum StatutVehicule {
  DISPONIBLE
  EN_SERVICE
  EN_MAINTENANCE
  HORS_SERVICE
}

enum TypeEntretien {
  VIDANGE_MOTEUR
  REVISION
  REPARATION
  PNEUS
  CARROSSERIE
  AUTRE
}

enum StatutToilette {
  DISPONIBLE
  LOUEE
  EN_MAINTENANCE
}

enum StatutFacture {
  EN_ATTENTE
  PAYEE
  PARTIELLEMENT_PAYEE
  EN_RETARD
  ANNULEE
}

enum ModePaiement {
  CASH
  VIREMENT
  CHEQUE
}

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  CONVERTI
}

// ─── PARAMÉTRAGE MÉTIER ──────────────────────────────────────────────────────

// Types de prestation et de véhicule, administrables depuis le backoffice.
//
// C'étaient des enum PostgreSQL jusqu'à la migration types_reference : ajouter
// une prestation imposait alors une migration de base. Ce sont des données de
// paramétrage métier, pas de la structure.
//
// Les colonnes qui portent ces codes (Intervention.type, Contrat.services,
// Technicien.specialites, LigneFacture.service…) restent du texte SANS clé
// étrangère : deux d'entre elles sont des TABLEAUX, sur lesquels PostgreSQL ne
// sait pas poser de FK. L'intégrité est donc vérifiée côté service —
// verifierTypesService / verifierTypeVehicule dans
// lib/services/types-reference.ts — et non par la base.
//
// Le champ "code" est la clé primaire plutôt qu'un id technique : c'est cette
// valeur qui est déjà stockée dans toutes les colonnes existantes.
model TypeService {
  code      String   @id
  libelle   String
  actif     Boolean  @default(true)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TypeVehicule {
  code      String   @id
  libelle   String
  actif     Boolean  @default(true)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── AUTH & AUDIT (nouveau — §1.6, §1.10) ────────────────────────────────────

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  nom          String
  prenom       String
  telephone    String?
  role         Role        @default(TECHNICIEN)
  actif        Boolean     @default(true)
  technicien   Technicien?
  sessions     Session[]
  auditLogs    AuditLog[]
  conversationsPrisesEnCharge Conversation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Sessions révocables en base — corrige §1.6 : sans cette table, /api/auth/logout
// ne fait rien et un JWT reste valide jusqu'à expiration même après déconnexion
// ou changement de mot de passe. Le token brut n'est jamais stocké, seul son hash.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Journal d'audit — alimente le "feed d'activité récente" du dashboard (Phase 5)
// et trace chaque transition de statut d'intervention, paiement, etc.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── CLIENTS & CONTRATS ──────────────────────────────────────────────────────

model Client {
  id            String           @id @default(cuid())
  code          String           @unique // JED-0001 — généré via séquence PostgreSQL, voir §1.4
  nom           String
  type          TypeClient       @default(PARTICULIER)
  telephone     String
  email         String?
  adresse       String?
  ville         String           @default("Port-au-Prince")
  notes         String?
  actif         Boolean          @default(true)
  contrats      Contrat[]
  interventions Intervention[]
  factures      Facture[]
  devis         Devis[]
  toilettes     ToiletteMobile[]
  codesConnexion CodeConnexionClient[]
  sessions      SessionClient[]
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([ville, actif])
}

// Portail client : connexion par code à 6 chiffres envoyé par e-mail, sans
// mot de passe à gérer côté client. Distinct de Session (réservé au
// personnel authentifié par mot de passe) — un client n'est pas un User.
model CodeConnexionClient {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  // Seul le hash est stocké (même logique que Session.tokenHash) : une fuite
  // de la base ne doit pas suffire à se connecter à la place du client.
  codeHash   String
  expiresAt  DateTime
  tentatives Int       @default(0)
  utiliseAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId, createdAt])
}

model SessionClient {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

model Contrat {
  id                 String         @id @default(cuid())
  reference          String         @unique // CTR-2026-0001
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id])
  type               TypeContrat
  services           String[]
  // Montant en centimes HTG — BigInt (§1.7) : un INTEGER Postgres plafonne à
  // ~21,4M HTG, insuffisant pour un contrat municipal pluriannuel.
  // Pas de montantUSD stocké (§1.11) : la gourde est volatile, un montant USD
  // dérivé et conservé fausserait l'historique. L'affichage USD se calcule à la
  // volée depuis Config["TAUX_USD_HTG"] ; seule la Facture fige un taux figé.
  montantHTG         BigInt
  dateDebut          DateTime
  dateFin            DateTime
  statut             StatutContrat  @default(ACTIF)
  renouvellementAuto Boolean        @default(false)
  interventions      Intervention[]
  factures           Facture[]
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([clientId, statut, dateFin])
}

// ─── OPÉRATIONS ──────────────────────────────────────────────────────────────

model Intervention {
  id               String                   @id @default(cuid())
  reference        String                   @unique // INT-2026-0001
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id])
  contratId        String?
  contrat          Contrat?                 @relation(fields: [contratId], references: [id])
  type             String
  description      String?
  adresse          String
  ville            String
  statut           StatutIntervention       @default(EN_ATTENTE)
  priorite         Priorite                 @default(NORMALE)
  // TELEPHONE par défaut : c'est le canal le plus courant pour une entreprise
  // d'assainissement en Haïti, et une valeur par défaut explicite évite de
  // forcer un choix sur les milliers d'interventions déjà en base au moment
  // de la migration (elles deviennent TELEPHONE plutôt que NULL).
  canal            CanalDemande             @default(TELEPHONE)
  datePlanifiee    DateTime?
  // Durée estimée en minutes — sert de base à la plage horaire utilisée par la
  // contrainte d'exclusion PostgreSQL anti double-booking ajoutée en Phase 1
  // (migration SQL manuelle ; Prisma n'exprime pas EXCLUDE USING gist). Voir §1.3.
  dureeEstimeeMin  Int                      @default(60)
  dateExecution    DateTime?
  techniciens      InterventionTechnicien[]
  vehiculeId       String?
  vehicule         Vehicule?                @relation(fields: [vehiculeId], references: [id])
  rapportExecution Json?
  photos           Media[]
  facture          Facture?
  deletedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([clientId, statut, datePlanifiee])
  @@index([vehiculeId, datePlanifiee])
}

// Table de jonction explicite (plutôt qu'un m2m implicite Prisma) : c'est sur
// cette table que la contrainte d'exclusion anti double-booking technicien
// (§1.3, Phase 1) sera ajoutée, et elle peut porter des champs futurs (rôle
// sur l'intervention, heures) sans migration de rupture.
model InterventionTechnicien {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id])
  technicienId   String
  technicien     Technicien   @relation(fields: [technicienId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([interventionId, technicienId])
  @@index([technicienId])
}

model Technicien {
  id             String                   @id @default(cuid())
  userId         String                   @unique
  user           User                     @relation(fields: [userId], references: [id])
  matricule      String                   @unique // TECH-001
  specialites    String[]
  zonesAssignees String[]
  disponible     Boolean                  @default(true)
  interventions  InterventionTechnicien[]
  presences      Presence[]
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model Presence {
  id           String     @id @default(cuid())
  technicienId String
  technicien   Technicien @relation(fields: [technicienId], references: [id])
  // @db.Date (pas DateTime) — §1.8 : avec une composante horaire, la contrainte
  // unique(technicienId, date) ne bloque rien, deux saisies le même jour à des
  // heures différentes créent deux lignes.
  date         DateTime   @db.Date
  present      Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())

  @@unique([technicienId, date])
  @@index([technicienId, date])
}

model Vehicule {
  id                String         @id @default(cuid())
  immatriculation   String         @unique
  marque            String
  modele            String
  type              String
  statut            StatutVehicule @default(DISPONIBLE)
  kilometrage       Int            @default(0)
  dernierEntretien  DateTime?
  prochainEntretien DateTime?
  notes             String?
  interventions     Intervention[]
  entretiens        EntretienVehicule[]
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([statut, deletedAt])
}

// Historique d'entretien — chaque passage à l'atelier laisse une ligne, plutôt
// que d'écraser les seuls champs dernierEntretien/prochainEntretien du
// véhicule. Sans cet historique, impossible de savoir ce qui a déjà été fait
// ni ce que la flotte a coûté.
model EntretienVehicule {
  id                String        @id @default(cuid())
  vehiculeId        String
  vehicule          Vehicule      @relation(fields: [vehiculeId], references: [id])
  type              TypeEntretien
  description       String?
  // Coût en centimes (BigInt) comme tout montant du système (§1.7) — jamais
  // de flottant sur de l'argent.
  coutHTG           BigInt        @default(0)
  // Kilométrage relevé au moment de l'entretien, pour suivre l'usure réelle
  // indépendamment du compteur courant du véhicule.
  kilometrage       Int?
  dateEntretien     DateTime      @default(now())
  prochainEntretien DateTime?
  createdBy         String?
  createdAt         DateTime      @default(now())

  @@index([vehiculeId, dateEntretien])
}

model ToiletteMobile {
  id                   String         @id @default(cuid())
  code                 String         @unique // TLT-001
  statut               StatutToilette @default(DISPONIBLE)
  localisationActuelle String?
  clientId             String?
  client               Client?        @relation(fields: [clientId], references: [id])
  dateDebutLocation    DateTime?
  dateFinLocation      DateTime?
  // Tarif figé au démarrage de LA location en cours — sert de base à la
  // facturation mensuelle automatique (genererFacturesLocationsToilettes,
  // même schéma d'idempotence que les contrats récurrents). Null tant
  // qu'aucune location n'est en cours, ou pour une location facturée
  // manuellement sans automatisation.
  tarifMensuelHTG      BigInt?
  factures             Facture[]
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

// ─── MÉDIAS (nouveau — §1.10) ────────────────────────────────────────────────

// Photos de rapport d'intervention ET photos de la galerie publique.
// Les fichiers eux-mêmes vivent sur R2/S3 (§1.2) — cette table ne stocke que
// l'URL et les métadonnées.
model Media {
  id             String        @id @default(cuid())
  url            String
  type           String?
  interventionId String?
  intervention   Intervention? @relation(fields: [interventionId], references: [id])
  legende        String?
  publieGalerie  Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([publieGalerie, type])
}

// ─── FACTURATION & FINANCE ───────────────────────────────────────────────────

model Facture {
  id              String         @id @default(cuid())
  reference       String         @unique // FAC-2026-0001
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  interventionId  String?        @unique
  intervention    Intervention?  @relation(fields: [interventionId], references: [id])
  contratId       String?
  contrat         Contrat?       @relation(fields: [contratId], references: [id])
  // Même principe que contratId ci-dessous : une location de toilette mobile
  // facturée automatiquement chaque mois (genererFacturesLocationsToilettes).
  // Jamais renseigné en même temps que contratId — deux origines distinctes
  // de facturation récurrente, jamais combinées sur une même facture.
  toiletteMobileId String?
  toiletteMobile  ToiletteMobile? @relation(fields: [toiletteMobileId], references: [id])
  // Période "2026-07" pour une facture récurrente de contrat mensuel — combinée
  // à contratId dans la contrainte unique ci-dessous pour garantir l'idempotence
  // du cron de facturation (§1.9) : impossible de générer deux factures pour le
  // même contrat sur la même période, même si le cron tourne en double.
  periode         String?
  lignes          LigneFacture[]
  montantHTG      BigInt
  taxeHTG         BigInt         @default(0)
  totalHTG        BigInt
  // Taux HTG→USD × 10000, figé au moment de l'émission (§1.11) — jamais
  // recalculé rétroactivement. Null si la facture n'affiche pas d'équivalent USD.
  tauxUsdApplique Int?
  statut          StatutFacture  @default(EN_ATTENTE)
  modePaiement    ModePaiement?
  dateEmission    DateTime       @default(now())
  dateEcheance    DateTime
  datePaiement    DateTime?
  notes           String?
  paiements       Paiement[]
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([contratId, periode])
  @@unique([toiletteMobileId, periode])
  @@index([clientId, statut, dateEcheance])
}

// Remplace le champ Json `lignes` du master prompt v1 (§1.13) : sans lignes
// réelles, impossible d'agréger "revenus par service" en SQL pour
// GET /api/factures/stats — il faudrait désérialiser chaque facture en mémoire.
model LigneFacture {
  id              String       @id @default(cuid())
  factureId       String
  facture         Facture      @relation(fields: [factureId], references: [id], onDelete: Cascade)
  description     String
  service         String?
  quantite        Int          @default(1)
  prixUnitaireHTG BigInt
  totalHTG        BigInt
  ordre           Int          @default(0)
}

model Paiement {
  id             String       @id @default(cuid())
  factureId      String
  facture        Facture      @relation(fields: [factureId], references: [id])
  montantHTG     BigInt
  mode           ModePaiement
  reference      String?
  // Fournie par le client (ex: hash du formulaire soumis) pour dédupliquer les
  // retries réseau et double-clics (§1.5) — un INSERT avec la même clé échoue
  // proprement au lieu de créer un second versement.
  idempotencyKey String       @unique
  datePaiement   DateTime     @default(now())
  createdBy      String
  createdAt      DateTime     @default(now())
}

// Catalogue de services/produits proposés par l'entreprise — sert uniquement
// à accélérer la saisie des lignes de facture/devis (autocomplétion +
// pré-remplissage du prix) : prixSuggereHTG reste indicatif et modifiable
// ligne par ligne, les tarifs réels variant par client/négociation. Pas de
// lien en base vers LigneFacture/LigneDevis — une ligne existante ne doit pas
// se casser si l'article catalogue est renommé ou désactivé après coup.
model ArticleCatalogue {
  id              String       @id @default(cuid())
  nom             String       @unique
  description     String?
  type            String?
  prixSuggereHTG  BigInt?
  actif           Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// Devis (quotation) distinct d'une facture impayée : pas de contrainte de
// séquence comptable ni des obligations fiscales d'une facture émise (§2.x).
// Cycle de vie BROUILLON → ENVOYE → ACCEPTE/REFUSE/EXPIRE, avec un passage
// possible vers CONVERTI une fois transformé en Facture (factureId renseigné).
model Devis {
  id              String       @id @default(cuid())
  reference       String       @unique // DEV-2026-0001
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  lignes          LigneDevis[]
  montantHTG      BigInt
  taxeHTG         BigInt       @default(0)
  totalHTG        BigInt
  tauxUsdApplique Int?
  statut          StatutDevis  @default(BROUILLON)
  dateEmission    DateTime     @default(now())
  dateValidite    DateTime
  // Renseigné lors de la conversion en facture — un devis ne peut être
  // converti qu'une seule fois (voir lib/services/devis.ts).
  factureId       String?      @unique
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clientId, statut])
}

model LigneDevis {
  id              String       @id @default(cuid())
  devisId         String
  devis           Devis        @relation(fields: [devisId], references: [id], onDelete: Cascade)
  description     String
  service         String?
  quantite        Int          @default(1)
  prixUnitaireHTG BigInt
  totalHTG        BigInt
  ordre           Int          @default(0)
}

// ─── DEMANDES PUBLIQUES ──────────────────────────────────────────────────────

model DemandeDevis {
  id        String      @id @default(cuid())
  nom       String
  telephone String
  email     String?
  service   String
  ville     String
  message   String?
  traite    Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model RendezVous {
  id         String      @id @default(cuid())
  nom        String
  telephone  String
  email      String?
  service    String
  ville      String
  adresse    String?
  dateVoulue DateTime
  message    String?
  statut     String      @default("EN_ATTENTE")
  createdAt  DateTime    @default(now())
}

// ─── CONTENU DU SITE VITRINE (nouveau — §1.10, Phase 4) ──────────────────────

model Temoignage {
  id          String   @id @default(cuid())
  nom         String
  type        String // libellé libre affiché : "Entreprise — AgroTrans Haiti"
  note        Int // 1 à 5
  commentaire String
  actif       Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── IA & SUPPORT ─────────────────────────────────────────────────────────────

enum StatutConversation {
  IA // Tiffany répond normalement.
  EN_ATTENTE_AGENT // IA indisponible — en file d'attente pour un humain.
  PRISE_EN_CHARGE // Un agent SUPPORT a répondu, la conversation lui est assignée.
  FERMEE
}

enum RoleMessage {
  VISITEUR
  IA
  AGENT
}

// Une conversation par sessionId de widget (voir ChatWidget.tsx, stocké en
// localStorage côté visiteur) — jamais liée à un compte : la vitrine est
// publique, sans authentification.
model Conversation {
  id        String               @id @default(cuid())
  sessionId String               @unique @default(cuid())
  statut    StatutConversation   @default(IA)
  agentId   String?
  agent     User?                @relation(fields: [agentId], references: [id])
  nom       String?
  telephone String?
  email     String?
  messages  MessageConversation[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([statut, updatedAt])
}

model MessageConversation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           RoleMessage
  contenu        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ─── CONFIGURATION ────────────────────────────────────────────────────────────

model Config {
  id        String   @id @default(cuid())
  cle       String   @unique // ex: "TAUX_USD_HTG"
  valeur    String
  updatedAt DateTime @updatedAt
}
